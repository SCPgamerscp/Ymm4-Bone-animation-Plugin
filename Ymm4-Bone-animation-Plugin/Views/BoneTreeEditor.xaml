<UserControl x:Class="Ymm4BoneAnimationPlugin.Views.BoneTreeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Ymm4BoneAnimationPlugin.Views"
             xmlns:c="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="320"
             d:DataContext="{d:DesignInstance Type={x:Type local:BoneTreeEditorViewModel}}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 操作ツールバー -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <!-- パペットボーンエディタ起動ボタン（メイン） -->
            <Button Content="🛠 ボーンエディタを開く (パペット変形)" Command="{Binding OpenPuppetEditorCommand}"
                    Background="#0E639C" Foreground="#FFFFFF" BorderBrush="#1177BB" FontWeight="Bold" Padding="10,8"
                    ToolTip="独立した専用エディタを開き、画像パーツの配置、ピン打ち、ボーン接続を行います"/>
        </Grid>

        <!-- ボーン階層ツリー（ドラッグ＆ドロップで親子関係を変更） -->
        <Border Grid.Row="1" BorderBrush="#40808080" BorderThickness="1">
            <TreeView x:Name="tree"
                      ItemsSource="{Binding RootNodes}"
                      AllowDrop="True"
                      SelectedItemChanged="Tree_SelectedItemChanged"
                      PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                      PreviewMouseMove="Tree_PreviewMouseMove"
                      DragOver="Tree_DragOver"
                      Drop="Tree_Drop"
                      Background="Transparent"
                      BorderThickness="0">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding DisplayName}" Padding="2,1"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Border>

        <!-- 選択中ボーンのプロパティ -->
        <c:PropertiesEditor Grid.Row="2"
                            Target="{Binding SelectedBone}"
                            BeginEdit="PropertiesEditor_BeginEdit"
                            EndEdit="PropertiesEditor_EndEdit"/>
    </Grid>
</UserControl>
