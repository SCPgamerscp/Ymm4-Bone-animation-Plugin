<Window x:Class="Ymm4BoneAnimationPlugin.Views.PuppetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ymm4BoneAnimationPlugin.Views"
        mc:Ignorable="d"
        Title="パペット ボーン エディタ"
        Height="760" Width="1120"
        MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#FFFFFF"
        d:DataContext="{d:DesignInstance Type=local:PuppetEditorViewModel}">

    <Window.Resources>
        <!-- ダークテーマ用ボタンスタイル -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2D30"/>
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 上部ツールバー -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ツールモード切り替え & Undo/Redo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="↩ 戻る" Command="{Binding UndoCommand}" ToolTip="元に戻す (Ctrl+Z)"/>
                    <Button Content="↪ 進む" Command="{Binding RedoCommand}" ToolTip="やり直す (Ctrl+Y / Ctrl+Shift+Z)"/>
                    <Separator Width="1" Margin="6,2" Background="#3F3F46"/>

                    <RadioButton Content="🖐 移動・選択" IsChecked="{Binding IsSelectMoveMode}" Padding="4,2"
                                 ToolTip="画像パーツやピンをドラッグ移動したり、クリックして選択します"/>
                    <RadioButton Content="📍 ピン追加 (クリック)" IsChecked="{Binding IsAddPinMode}" Padding="4,2"
                                 ToolTip="パーツ画像上の関節位置をクリックしてピンを追加します"/>
                    <RadioButton Content="🦴 ボーン接続 (ドラッグ)" IsChecked="{Binding IsConnectBoneMode}" Padding="4,2"
                                 ToolTip="ピンから別のピンへドラッグしてボーン（親子関係）を結びます"/>
                    <Separator Width="1" Margin="6,2" Background="#3F3F46"/>

                    <Button Content="📁 画像追加" Command="{Binding AddImagesCommand}" ToolTip="背景パーツ画像を追加します（直接ドラッグ＆ドロップも可能）"/>
                    <Button Content="🗑 ピン削除" Command="{Binding DeleteSelectedCommand}" ToolTip="選択中のピンを削除します (Deleteキー)"/>
                    <Button Content="🔄 全クリア" Command="{Binding ClearAllCommand}" ToolTip="すべてのピンと画像をクリアします"/>
                    <Button Content="🔍 リセット" Command="{Binding ResetViewCommand}" ToolTip="表示位置と倍率を初期化します"/>
                </StackPanel>

                <!-- ガイド説明 -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#888888" FontSize="11"
                           Text="ホイール: ズーム | 中/右ドラッグ: 平行移動 | 画像/ピンをクリックで選択してドラッグ配置"/>

                <!-- 完了 / キャンセルボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="✔ 適用して閉じる" Click="ApplyButton_Click" Background="#0E639C" BorderBrush="#1177BB" FontWeight="Bold" Padding="12,5"/>
                    <Button Content="✖ キャンセル" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインエディタ領域（キャンバス + 右側プロパティ） -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- キャンバス領域（ズーム・パン対応） -->
            <Border Grid.Column="0" x:Name="CanvasContainer" Background="#181818" ClipToBounds="True"
                    AllowDrop="True" Drop="Canvas_Drop" DragOver="Canvas_DragOver"
                    MouseWheel="Canvas_MouseWheel"
                    MouseDown="Canvas_MouseDown" MouseMove="Canvas_MouseMove" MouseUp="Canvas_MouseUp">
                <Canvas x:Name="MainCanvas" Background="Transparent" Focusable="True">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                            <TranslateTransform x:Name="CanvasTranslate" X="{Binding PanX}" Y="{Binding PanY}"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- 画像レイヤー描画用コンテナ -->
                    <Canvas x:Name="ImageLayerCanvas"/>

                    <!-- ボーン接続線描画用コンテナ -->
                    <Canvas x:Name="BoneLinesCanvas"/>

                    <!-- ピン描画用コンテナ -->
                    <Canvas x:Name="PinsCanvas"/>

                    <!-- 接続ドラッグ中のプレビュー線 -->
                    <Line x:Name="ConnectingLine" Stroke="#FF9800" StrokeThickness="2.5" StrokeDashArray="4 2" Visibility="Collapsed"/>
                </Canvas>
            </Border>

            <!-- 右側：設定サイドバー（ピン / 画像パーツ） -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- ピン設定 -->
                        <GroupBox Header="📍 選択中ピンの設定" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,12" Padding="8">
                            <StackPanel IsEnabled="{Binding SelectedPin, Converter={x:Static local:PuppetEditorWindow.NotNullConverter}}">
                                <TextBlock Text="ピン名" Foreground="#AAAAAA" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedPin.Name, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X 座標" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SelectedPin.X, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y 座標" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SelectedPin.Y, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="アンカーX (0~1)" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SelectedPin.AnchorX, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="アンカーY (0~1)" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SelectedPin.AnchorY, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="重なり順 (Z順)" Foreground="#AAAAAA" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding SelectedPin.ZOrder, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>

                                <TextBlock Text="割り当て画像" Foreground="#AAAAAA" Margin="0,6,0,2"/>
                                <TextBox Text="{Binding SelectedPin.ImagePath, Mode=OneWay}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4" IsReadOnly="True"/>
                                <Button Content="画像を選択..." Click="BrowsePinImage_Click" Margin="0,4,0,0" HorizontalAlignment="Right"/>

                                <Separator Margin="0,10" Background="#3F3F46"/>

                                <!-- 口パク・目パチ設定 -->
                                <TextBlock Text="👄 口パク・目パチ設定" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,2,0,4"/>
                                <CheckBox Content="口パク連動" IsChecked="{Binding SelectedPin.IsLipSyncEnabled}" Foreground="#EEEEEE" Margin="0,2,0,4"/>
                                <TextBlock Text="口パク差分名 (開,半開,閉)" Foreground="#AAAAAA" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedPin.LipSyncSlotNames, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>

                                <TextBlock Text="口パク縦伸縮 (0~1)" Foreground="#AAAAAA" Margin="0,4,0,2"/>
                                <TextBox Text="{Binding SelectedPin.LipSyncScaleInfluence, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>

                                <CheckBox Content="目パチ連動" IsChecked="{Binding SelectedPin.IsBlinkEnabled}" Foreground="#EEEEEE" Margin="0,8,0,4"/>
                                <TextBlock Text="目パチ差分名 (開,半開,閉)" Foreground="#AAAAAA" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedPin.BlinkSlotNames, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>

                                <Separator Margin="0,10" Background="#3F3F46"/>

                                <!-- IK・物理設定 -->
                                <TextBlock Text="🦴 IK・物理演算" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,2,0,4"/>
                                <CheckBox Content="IKを使用 (手足の先端)" IsChecked="{Binding SelectedPin.IsIkEnabled}" Foreground="#EEEEEE" Margin="0,2,0,4"/>
                                <CheckBox Content="揺れものにする (物理演算)" IsChecked="{Binding SelectedPin.IsPhysicsEnabled}" Foreground="#EEEEEE" Margin="0,2,0,4"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- レイヤー一覧（重なり順） -->
                        <GroupBox Header="📚 パーツレイヤー一覧 (重なり順)" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,12" Padding="8">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="⏫ 最前面" Command="{Binding BringLayerToFrontCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="一番手前に表示"/>
                                    <Button Content="▲ 前面へ" Command="{Binding BringLayerForwardCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="1つ手前に移動"/>
                                    <Button Content="▼ 背面へ" Command="{Binding SendLayerBackwardCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="1つ奥に移動"/>
                                    <Button Content="⏬ 最背面" Command="{Binding SendLayerToBackCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="一番奥に表示"/>
                                    <Button Content="🗑 削除" Command="{Binding DeleteLayerCommand}" Padding="5,2" ToolTip="パーツを削除"/>
                                </WrapPanel>
                                <Border BorderBrush="#3F3F46" BorderThickness="1" Background="#1E1E1E" Height="110">
                                    <ListBox ItemsSource="{Binding ImageLayers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0" Foreground="#EEEEEE">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <TextBlock Text="🖼 " Foreground="#888888"/>
                                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- 画像パーツ設定 -->
                        <GroupBox Header="🖼 選択中画像パーツの設定" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,12" Padding="8">
                            <StackPanel IsEnabled="{Binding SelectedLayer, Converter={x:Static local:PuppetEditorWindow.NotNullConverter}}">
                                <TextBlock Text="ファイル名" Foreground="#AAAAAA" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedLayer.FileName, Mode=OneWay}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4" IsReadOnly="True"/>

                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="X 位置" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SelectedLayer.X, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Y 位置" Foreground="#AAAAAA"/>
                                        <TextBox Text="{Binding SelectedLayer.Y, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="前後関係 (重なり順)" Foreground="#AAAAAA" Margin="0,6,0,2"/>
                                <WrapPanel Margin="0,2,0,4">
                                    <Button Content="⏫ 最前面" Command="{Binding BringLayerToFrontCommand}" Padding="5,2" Margin="0,0,3,2"/>
                                    <Button Content="▲ 前面へ" Command="{Binding BringLayerForwardCommand}" Padding="5,2" Margin="0,0,3,2"/>
                                    <Button Content="▼ 背面へ" Command="{Binding SendLayerBackwardCommand}" Padding="5,2" Margin="0,0,3,2"/>
                                    <Button Content="⏬ 最背面" Command="{Binding SendLayerToBackCommand}" Padding="5,2" Margin="0,0,3,2"/>
                                    <Button Content="🗑 削除" Command="{Binding DeleteLayerCommand}" Padding="5,2" Margin="0,0,0,2"/>
                                </WrapPanel>
                            </StackPanel>
                        </GroupBox>

                        <!-- 操作ガイド -->
                        <TextBlock Text="💡 パーツ結合の手順" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,4,0,4"/>
                        <TextBlock Text="1. [📁 画像追加] で体・腕などのパーツ画像を読み込みます&#x0a;2. [🖐 移動・選択] でパーツをドラッグしてキャラクターの形に並べます&#x0a;3. [📍 ピン追加] で各パーツの関節位置をクリックしてピンを打ちます&#x0a;4. [🦴 ボーン接続] でピン間をドラッグして骨組みを結合します&#x0a;5. [✔ 適用して閉じる] を押してYMM4に反映します"
                                   Foreground="#888888" TextWrapping="Wrap" LineHeight="18" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="パペット ボーン エディタ - パーツ画像を配置し、ピンを打って直感的にボーン接続" FontSize="11" Foreground="#FFFFFF"/>
                <TextBlock Grid.Column="1" Text="{Binding Zoom, StringFormat='倍率: {0:P0}'}" FontSize="11" Foreground="#FFFFFF"/>
            </Grid>
        </Border>
    </Grid>
</Window>
