<Window x:Class="Ymm4BoneAnimationPlugin.Views.PuppetEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ymm4BoneAnimationPlugin.Views"
        mc:Ignorable="d"
        Title="2Dパペット ボーン結合エディタ"
        Height="780" Width="1100"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="#FFFFFF">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#333337"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#3F3F46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="#252526" BorderBrush="#3F3F46" BorderThickness="0,0,0,1" Padding="6,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 操作ボタン & Undo/Redo -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="↩ 戻る" Command="{Binding UndoCommand}" ToolTip="元に戻す (Ctrl+Z)"/>
                    <Button Content="↪ 進む" Command="{Binding RedoCommand}" ToolTip="やり直す (Ctrl+Y / Ctrl+Shift+Z)"/>
                    <Separator Width="1" Margin="6,2" Background="#3F3F46"/>

                    <Button Content="📁 画像追加" Command="{Binding AddImagesCommand}" ToolTip="パーツ画像を追加します（直接ドラッグ＆ドロップも可能）"/>
                    <Button Content="🔄 全クリア" Command="{Binding ClearAllCommand}" ToolTip="すべてのパーツをクリアします"/>
                    <Button Content="🔍 リセット" Command="{Binding ResetViewCommand}" ToolTip="表示位置と倍率を初期化します"/>
                </StackPanel>

                <!-- ガイド説明 -->
                <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="#888888" FontSize="11"
                           Text="ホイール: ズーム | 中/右ドラッグ: 画面移動 | 関節ピンをドラッグして関節位置を調整"/>

                <!-- 完了 / キャンセルボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="✔ 適用して閉じる" Click="ApplyButton_Click" Background="#0E639C" BorderBrush="#1177BB" FontWeight="Bold" Padding="14,5"/>
                    <Button Content="✖ キャンセル" Click="CancelButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- メインコンテンツエリア -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <!-- キャンバス表示エリア -->
            <Border Grid.Column="0" Background="#141414" ClipToBounds="True"
                    AllowDrop="True"
                    DragOver="Canvas_DragOver" Drop="Canvas_Drop"
                    MouseWheel="Canvas_MouseWheel"
                    MouseDown="Canvas_MouseDown"
                    MouseMove="Canvas_MouseMove"
                    MouseUp="Canvas_MouseUp"
                    x:Name="CanvasContainer">

                <Canvas x:Name="MainCanvas">
                    <Canvas.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="CanvasScale" ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/>
                            <TranslateTransform x:Name="CanvasTranslate" X="{Binding PanX}" Y="{Binding PanY}"/>
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <!-- 画像パーツ描画レイヤー -->
                    <Canvas x:Name="ImageLayerCanvas"/>

                    <!-- ボーン骨組み接続線 -->
                    <Canvas x:Name="BoneLinesCanvas"/>

                    <!-- 関節ピン描画レイヤー -->
                    <Canvas x:Name="JointPinsCanvas"/>

                    <!-- ドラッグ接続時の仮ライン -->
                    <Line x:Name="ConnectingLine" Stroke="#FFCC00" StrokeThickness="2.5" StrokeDashArray="4 2" Visibility="Collapsed"/>
                </Canvas>
            </Border>

            <!-- 右側：ボーン・パーツ設定パネル -->
            <Border Grid.Column="1" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,0,0,0" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- レイヤー一覧（重なり順 & ボーン階層） -->
                        <GroupBox Header="📚 パーツレイヤー一覧 (画像＝ボーン)" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,12" Padding="8">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,6">
                                    <Button Content="⏫ 最前面" Command="{Binding BringLayerToFrontCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="一番手前に表示"/>
                                    <Button Content="▲ 前面へ" Command="{Binding BringLayerForwardCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="1つ手前に移動"/>
                                    <Button Content="▼ 背面へ" Command="{Binding SendLayerBackwardCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="1つ奥に移動"/>
                                    <Button Content="⏬ 最背面" Command="{Binding SendLayerToBackCommand}" Padding="5,2" Margin="0,0,3,0" ToolTip="一番奥に表示"/>
                                    <Button Content="🗑 削除" Command="{Binding DeleteLayerCommand}" Padding="5,2" ToolTip="パーツを削除"/>
                                </WrapPanel>
                                <Border BorderBrush="#3F3F46" BorderThickness="1" Background="#1E1E1E" Height="140">
                                    <ListBox ItemsSource="{Binding ImageLayers}" SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                                             Background="Transparent" BorderThickness="0" Foreground="#EEEEEE">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="ItemBorder" CornerRadius="4" Padding="4,3" Margin="1,2" BorderThickness="1.5"
                                                        BorderBrush="Transparent" Background="#252528">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="36"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <!-- サムネイルプレビュー -->
                                                        <Border Grid.Column="0" Width="32" Height="32" Background="#18181A" BorderBrush="#4A4A4D" BorderThickness="1" CornerRadius="2">
                                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="1"/>
                                                        </Border>

                                                        <!-- パーツ名とZ順 -->
                                                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="FileNameText" Text="{Binding PartName}" FontWeight="Bold" FontSize="11" TextTrimming="CharacterEllipsis" Foreground="#EEEEEE"/>
                                                            <TextBlock Text="{Binding ZOrder, StringFormat='Z順: {0}'}" Foreground="#888888" FontSize="10"/>
                                                        </StackPanel>

                                                        <!-- 親ボーン情報バッジ -->
                                                        <Border x:Name="ParentBadge" Grid.Column="2" Background="#2A3540" BorderBrush="#3584E4" BorderThickness="1" CornerRadius="3" Padding="5,2" Margin="4,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock x:Name="ParentBadgeText" Text="{Binding ParentName, StringFormat='親: {0}'}" Foreground="#78AEED" FontSize="10" FontWeight="Bold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>

                                                <DataTemplate.Triggers>
                                                    <!-- パーツ選択時にピカッとオレンジ色に発光！ -->
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="#4D2800"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FF8800"/>
                                                        <Setter TargetName="FileNameText" Property="Foreground" Value="#FFAA33"/>
                                                        <Setter TargetName="ParentBadge" Property="Background" Value="#803300"/>
                                                        <Setter TargetName="ParentBadge" Property="BorderBrush" Value="#FFAA00"/>
                                                        <Setter TargetName="ParentBadgeText" Property="Foreground" Value="#FFDD66"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </StackPanel>
                        </GroupBox>

                        <!-- 選択中パーツのボーン結合設定 -->
                        <GroupBox Header="🦴 ボーン結合（親子関係の設定）" Foreground="#CCCCCC" BorderBrush="#3F3F46" Margin="0,0,0,12" Padding="8">
                            <StackPanel IsEnabled="{Binding SelectedLayer, Converter={x:Static local:PuppetEditorWindow.NotNullConverter}}">
                                <TextBlock Text="選択中パーツ名" Foreground="#AAAAAA" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedLayer.PartName, Mode=OneWay}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4" IsReadOnly="True" FontWeight="Bold"/>

                                <TextBlock Text="結合する親パーツ（親ボーン）" Foreground="#AAAAAA" Margin="0,6,0,2"/>
                                <ComboBox ItemsSource="{Binding AvailableParents}"
                                          SelectedValue="{Binding SelectedLayer.ParentId, Mode=TwoWay}"
                                          SelectedValuePath="Id"
                                          DisplayMemberPath="Name"
                                          Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="4"/>
                                <Button Content="❌ 親子結合を解除（ルートにする）" Command="{Binding UnlinkParentCommand}" Margin="0,4,0,0" HorizontalAlignment="Right" FontSize="11"/>

                                <Separator Margin="0,8" Background="#3F3F46"/>

                                <!-- 関節ピン（回転中心・アンカー） -->
                                <TextBlock Text="📍 関節位置（回転の中心）" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,2,0,4"/>
                                <TextBlock Text="※ キャンバス上のピンを直接ドラッグしても調整できます" Foreground="#888888" FontSize="10" Margin="0,0,0,4"/>
                                <Grid Margin="0,2,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="アンカーX (0~1)" Foreground="#AAAAAA" FontSize="11"/>
                                        <TextBox Text="{Binding SelectedLayer.AnchorX, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="3"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="アンカーY (0~1)" Foreground="#AAAAAA" FontSize="11"/>
                                        <TextBox Text="{Binding SelectedLayer.AnchorY, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="3"/>
                                    </StackPanel>
                                </Grid>

                                <Separator Margin="0,8" Background="#3F3F46"/>

                                <!-- 口パク・目パチ設定 -->
                                <TextBlock Text="👄 口パク・目パチ設定" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,2,0,4"/>
                                <CheckBox Content="口パク連動" IsChecked="{Binding SelectedLayer.IsLipSyncEnabled}" Foreground="#EEEEEE" Margin="0,2,0,4"/>
                                <TextBlock Text="口パク差分名 (開,半開,閉)" Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedLayer.LipSyncSlotNames, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="3"/>

                                <TextBlock Text="口パク縦伸縮 (0~1)" Foreground="#AAAAAA" FontSize="11" Margin="0,4,0,2"/>
                                <TextBox Text="{Binding SelectedLayer.LipSyncScaleInfluence, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="3"/>

                                <CheckBox Content="目パチ連動" IsChecked="{Binding SelectedLayer.IsBlinkEnabled}" Foreground="#EEEEEE" Margin="0,6,0,4"/>
                                <TextBlock Text="目パチ差分名 (開,半開,閉)" Foreground="#AAAAAA" FontSize="11" Margin="0,2,0,2"/>
                                <TextBox Text="{Binding SelectedLayer.BlinkSlotNames, UpdateSourceTrigger=PropertyChanged}" Background="#333337" Foreground="#FFFFFF" BorderBrush="#3F3F46" Padding="3"/>

                                <Separator Margin="0,8" Background="#3F3F46"/>

                                <!-- IK・物理設定 -->
                                <TextBlock Text="🦴 IK・物理演算" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,2,0,4"/>
                                <CheckBox Content="IKを使用 (手足の先端)" IsChecked="{Binding SelectedLayer.IsIkEnabled}" Foreground="#EEEEEE" Margin="0,2,0,4"/>
                                <CheckBox Content="揺れものにする (物理演算)" IsChecked="{Binding SelectedLayer.IsPhysicsEnabled}" Foreground="#EEEEEE" Margin="0,2,0,4"/>
                            </StackPanel>
                        </GroupBox>

                        <!-- 操作ガイド -->
                        <TextBlock Text="💡 画像と画像のボーン結合方法" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,4,0,4"/>
                        <TextBlock Text="【方法1 (サイドバー)】&#x0a;パーツを選び、[結合する親パーツ] から親（体など）を選ぶだけで一瞬で骨が繋がります！&#x0a;&#x0a;【方法2 (キャンバス)】&#x0a;[📍 関節ピン配置] で親パーツの関節 → 子パーツの関節 をクリックしていくだけで骨組みが完成します。"
                                   Foreground="#888888" TextWrapping="Wrap" LineHeight="17" FontSize="11"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ステータスバー -->
        <Border Grid.Row="2" Background="#007ACC" Padding="8,3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="✨ 画像そのものがボーンとして直感的に結合されます" Foreground="#FFFFFF" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="{Binding ImageLayers.Count, StringFormat='パーツ総数: {0}'}" Foreground="#FFFFFF" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
