<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Core ロジック検証用テストプロジェクト。
    YMM4 本体 DLL / Direct2D に依存しない Core フォルダのみをコンパイルするため、
    Windows 以外の環境でも `dotnet test` が実行できる。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Ymm4BoneAnimationPlugin.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Ymm4-Bone-animation-Plugin/Core/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
